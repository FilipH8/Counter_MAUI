<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Projektv2.Views.CounterView">

    <Border
        Stroke="#D1D5D8"
        StrokeThickness="1"
        Padding="15"
        StrokeShape="RoundRectangle 15">
        <VerticalStackLayout
            Spacing="10">
            <Label
                x:Name="NameLabel"
                FontSize="22"
                HorizontalOptions="Center"/>
            <Label
                x:Name="CountLabel"
                Text="0"
                FontSize="40"
                HorizontalOptions="Center"/>
            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="20">
                <Button
                    Text="-"
                    WidthRequest="65"
                    Clicked="Minus_Clicked"/>
                <Button
                    Text="+"
                    WidthRequest="65"
                    Clicked="Plus_Clicked"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
