<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Projektv2.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Label
                Text="Moje liczniki"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"/>
            <Entry
                x:Name="NameEntry"
                Placeholder="Podaj nazwę licznika"/>
            <Entry
                x:Name="CountEntry"
                Placeholder="Podaj wartość początkową licznika"/>
            <Button
                Text="Dodaj licznik"
                Clicked="AddCounter_Clicked"/>
            <VerticalStackLayout
                x:Name="CounterList"
                Spacing="15">
                
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
